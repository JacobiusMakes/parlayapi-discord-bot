# Copy to .env (or export in your shell / pass with docker run -e).
# Never commit real tokens.

# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Recommended: free ParlayAPI key (1,000 credits/month, no card) from
# https://parlay-api.com/signup. Leave empty for keyless demo mode
# (6 sports, moneylines only, first 5 events, labeled in every embed).
PARLAY_API_KEY=

# Optional tuning
# PARLAY_BOT_DEFAULT_SPORT=americanfootball_nfl
# PARLAY_BOT_COOLDOWN_SECONDS=15
# PARLAY_BOT_CACHE_SECONDS=60
# PARLAY_API_BASE=https://parlay-api.com
